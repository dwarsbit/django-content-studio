msgstr "Afgeleverd: de webhook antwoordde met %(status)s."

#: webhooks/admin.py
#, python-format
msgid "The delivery failed and is retried later: %(error)s"
msgstr "De levering is mislukt en wordt later opnieuw geprobeerd: %(error)s"

#: webhooks/admin.py
#, python-format
msgid "The delivery failed: %(error)s"
msgstr "De levering is mislukt: %(error)s"

#: webhooks/admin.py
msgid "The webhook was created. Copy its secret now: it is not shown again."
msgstr ""
"De webhook is aangemaakt. Kopieer nu het geheim: het wordt niet opnieuw "
"getoond."

